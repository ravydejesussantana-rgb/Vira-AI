# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA suba o arquivo ".env" (com a chave de verdade) para lugar nenhum público.

OPENAI_API_KEY=coloque_sua_chave_aqui

# Porta em que o servidor vai rodar (Render/Railway definem isso automaticamente,
# pode deixar como está)
PORT=3000

# Opcional: limite de tamanho do prompt final (deixe como está se não souber)
